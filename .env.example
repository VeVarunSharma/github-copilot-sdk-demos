# Microsoft Foundry deployment name. This is the model value sent to the endpoint.
FOUNDRY_MODEL=gpt-5.2-codex

# Azure Foundry endpoint. Do not append /openai/v1/; the SDK builds the route.
FOUNDRY_BASE_URL=https://your-resource.openai.azure.com

FOUNDRY_API_KEY=replace-me

# Use "responses" for GPT-5-series deployments; use "completions" when required
# by an older or Chat Completions-only deployment.
FOUNDRY_WIRE_API=responses

# Optional Azure API version. Omit to use the SDK's versionless v1 route.
# FOUNDRY_API_VERSION=2024-10-21